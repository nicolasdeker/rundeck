{
  "name": "rdx-ui",
  "version": "0.0.0",
  "private": true,
  "description": "rdx web UI (rebuilt frontend, MISSION \u00a73.8) \u2014 Vue 3 + Vite + PrimeVue 4 + Tailwind 4",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check . && vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "pinia": "4.1.0",
    "primeicons": "8.0.2",
    "primevue": "4.5.5",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "overrides": {
      "js-beautify>glob": "14.0.4",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5"
    }
  }
}
